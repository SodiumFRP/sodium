<Project>

    <!--
        Package metadata shared by every packable project here. Anything that identifies an
        individual package — PackageId, Title, Product, Description, AssemblyName, RootNamespace —
        stays in that project's own file.
    -->
    <PropertyGroup>
        <Authors>SodiumFRP</Authors>
        <Company>SodiumFRP</Company>
        <PackageLicenseUrl>http://opensource.org/licenses/MIT</PackageLicenseUrl>
        <PackageProjectUrl>https://github.com/SodiumFRP/sodium</PackageProjectUrl>
        <IncludeSource>True</IncludeSource>
        <IncludeSymbols>True</IncludeSymbols>
    </PropertyGroup>

    <!--
        Versions come from git tags via MinVer, so no project hardcodes Version, PackageVersion,
        AssemblyVersion, FileVersion or InformationalVersion any more.

        Each packable project sets its own MinVerTagPrefix, and that is what lets these packages
        release on independent schedules: a project's stable version only moves when a tag carrying
        its own prefix is pushed. Tagging dotnet-async-1.1.0 releases the C# async wrapper at 1.1.0
        and leaves every other package where its own last tag put it. This follows the per-component
        tagging already used in this repository — haskell-*, java-*, sodium-*.

        A commit with no matching tag builds as a prerelease of the next patch, e.g.
        1.0.1-alpha.0.7, where 7 counts commits since the tag. CI can therefore build and pack every
        commit while only tagged builds ever produce a version worth publishing.

        To collapse several packages onto one release train, give them the same prefix; they then
        version and release together off a single tag.

        Guarded on UsingMicrosoftNETSdk because four of the C# test projects here are legacy,
        non-SDK projects using packages.config, which cannot consume a PackageReference.
    -->
    <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
        <PackageReference Include="MinVer" Version="6.1.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
